# Copy to .env.local for local development. Never commit real values.
# Local Supabase values come from `npx supabase status -o env` after `npm run db:start`.

# --- Public (sent to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=        # PUBLISHABLE_KEY (sb_publishable_…)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=                # npx web-push generate-vapid-keys

# --- Server only ---
SUPABASE_SECRET_KEY=                         # SECRET_KEY (sb_secret_…)
CRON_SECRET=                                 # openssl rand -hex 32 (also stored in Supabase Vault)
VAPID_PRIVATE_KEY=                           # from the same web-push command
VAPID_SUBJECT=mailto:you@example.com
ACTION_TOKEN_SECRET=                         # optional: signs notification buttons; derived from CRON_SECRET if empty

# --- Google Calendar (optional; docs/setup.md B.9) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=                        # openssl rand -base64 32
